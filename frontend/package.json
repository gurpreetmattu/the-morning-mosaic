{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "tokens": "node design/scripts/build-tokens.mjs",
    "tokens:check": "node design/scripts/check-contrast.mjs",
    "prebuild": "npm run tokens",
    "predev": "npm run tokens",
    "tokens:backend": "node design/scripts/sync-backend.mjs",
    "tokens:backend:check": "node design/scripts/sync-backend.mjs --check",
    "perf:lighthouse": "node tests/perf/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/old-standard-tt": "^5.3.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
