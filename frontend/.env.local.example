# Copy to .env.local for local development. Never commit .env.local.

# Where the FastAPI backend is running in dev. next.config.ts proxies
# /api/* and /admin/api/* to this origin so the browser only ever talks to
# this frontend's own origin — see the comment in next.config.ts for why
# that matters for the backend's session and CSRF cookies. Not needed in
# prod: there, one load balancer routes both services under the public
# domain (see docs/BACKLOG.md), and this variable is unused.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional. Cloudflare Turnstile site key for the signup form's bot check.
# Leave unset in dev — the backend already skips the check when it has no
# secret configured outside prod (app/api/security.py:verify_turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
