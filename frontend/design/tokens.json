  "fonts": {
    "masthead": "var(--nf-masthead), \"Abril Fatface\", \"Playfair Display\", Georgia, serif",
    "headline": "var(--nf-headline), \"Old Standard TT\", Georgia, \"Times New Roman\", serif",
    "body": "var(--nf-body), \"Libre Caslon Text\", Georgia, \"Times New Roman\", serif",
    "flag": "var(--nf-flag), \"Alfa Slab One\", Rockwell, \"Courier New\", serif",
    "ui": "var(--nf-ui), \"Libre Franklin\", \"Franklin Gothic Medium\", \"Arial Narrow\", Arial, sans-serif",
    "type": "var(--nf-mono), \"Courier Prime\", ui-monospace, \"Courier New\", monospace",
    "data": "var(--nf-mono), \"Courier Prime\", ui-monospace, Menlo, monospace"
  },
  "fontSizes": {
    "masthead": "clamp(2.5rem, 8.5vw, 7rem)",
    "display": "clamp(2rem, 5vw, 3.75rem)",
    "h2": "clamp(1.5rem, 3vw, 2.25rem)",
    "h3": "clamp(1.25rem, 2vw, 1.5rem)",
    "headline": "1.375rem",
    "body": "1.0625rem",
    "ui": "1rem",
    "small": "0.875rem",
    "kicker": "0.75rem"
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "motion": {
    "dur-fast": "120ms",
    "dur-base": "200ms",
    "dur-slow": "300ms",
    "dur-draw": "500ms",
    "ease-press": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "ease-inout": "cubic-bezier(0.65, 0, 0.35, 1)",
    "ease-step-4": "steps(4, end)",
    "ease-step-8": "steps(8, end)"
  },
  "email": {
    "serif": "Georgia, 'Times New Roman', serif",
    "sans": "Arial, Helvetica, sans-serif",
    "mono": "'Courier New', Courier, monospace"
  }
}
