# The Morning Mosaic — every environment variable, without values.
# Copy to .env for local development. Never commit .env.

# --- Core ---
# dev | prod
APP_ENV=
# public origin, e.g. https://<service>.run.app
BASE_URL=
TIMEZONE=Asia/Kolkata
LOG_LEVEL=

# --- Database (Neon, pooled connection string) ---
DATABASE_URL=

# --- Email sending (Gmail SMTP) ---
SMTP_HOST=
SMTP_PORT=
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=

# --- Bounce processing (same mailbox, read-only usage) ---
IMAP_HOST=
IMAP_PORT=

# --- Delivery safety ---
ADMIN_EMAIL=
# comma-separated; the only addresses dev may email
TEST_EMAIL_ALLOWLIST=
# Both have defaults (400 / 50). Leave commented out rather than blank:
# these are plain ints, and Settings tries to parse whatever string is
# here, so KEY= with nothing after it fails instead of falling back.
# MAX_ACTIVE_SUBSCRIBERS=400
# FAILURE_NOTICE_AUTO_LIMIT=50

# --- LLM access (Groq, OpenAI-compatible; api.groq.com/openai/v1) ---
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
# Optional. Same rule as above: an optional URL field left blank (KEY=)
# fails validation, unlike an optional string/secret field — leave it
# commented out, not blank, until you actually have a fallback provider.
# LLM_FALLBACK_URL=
# LLM_FALLBACK_API_KEY=

# --- Tokens and anti-abuse ---
TOKEN_SIGNING_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- News APIs ---
NEWSDATA_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=

# --- Extras data providers ---
OPENWEATHERMAP_API_KEY=
MARKET_API_KEY=
SPORTS_API_KEY=
TMDB_API_KEY=

# --- Images ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional URL field: leave commented out, not blank (see the note above
# LLM_FALLBACK_URL) — KEY= with nothing after it fails validation.
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- GCP ---
GCP_PROJECT_ID=
GCP_REGION=
GCS_PDF_BUCKET=

# --- PDF caching outside prod (local disk; ignored once GCS_PDF_BUCKET is set) ---
PDF_CACHE_DIR=
