# The Morning Mosaic — every environment variable, without values.
# Copy to .env for local development. Never commit .env.

# --- Core ---
# dev | prod
APP_ENV=
# public origin, e.g. https://<service>.run.app
BASE_URL=
TIMEZONE=Asia/Kolkata
LOG_LEVEL=

# --- Database (Neon, pooled connection string) ---
DATABASE_URL=
# Optional. Same connection string with "-pooler" removed from the hostname
# — Neon's direct (unpooled) endpoint. Required wherever DATABASE_URL is
# pooled: PgBouncer's transaction mode can silently hand the job lock's
# advisory lock to a different physical backend otherwise (see
# app/jobs/locking.py). Leave unset for a single non-pooled local Postgres.
# DATABASE_DIRECT_URL=

# --- Email sending (Gmail SMTP) ---
SMTP_HOST=
SMTP_PORT=
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=

# --- Bounce processing (same mailbox, read-only usage) ---
IMAP_HOST=
IMAP_PORT=

# --- Delivery safety ---
ADMIN_EMAIL=
# comma-separated; the only addresses dev may email
TEST_EMAIL_ALLOWLIST=
# Both have defaults (400 / 50). Leave commented out rather than blank:
# these are plain ints, and Settings tries to parse whatever string is
# here, so KEY= with nothing after it fails instead of falling back.
# MAX_ACTIVE_SUBSCRIBERS=400
# FAILURE_NOTICE_AUTO_LIMIT=50

# --- LLM access (Groq, OpenAI-compatible; api.groq.com/openai/v1) ---
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
# Optional. Same rule as above: an optional URL field left blank (KEY=)
# fails validation, unlike an optional string/secret field — leave it
# commented out, not blank, until you actually have a fallback provider.
# Only used by non-pinned agents that also set a fallback_model in
# config/models.yaml (Writer/Fact-checker are pinned and never use this).
# Verified live 2026-09-18: Google AI Studio's Gemini free tier works at
# https://generativelanguage.googleapis.com/v1beta/openai with model
# gemini-flash-lite-latest, and is a separate quota bucket from Groq.
# LLM_FALLBACK_URL=
# LLM_FALLBACK_API_KEY=
# A second, distinct alternate gateway — currently Cloudflare Workers AI,
# for Fact-checker (kept off the same vendor as Writer's fallback gateway
# on purpose). https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# with model @cf/meta/llama-3.3-70b-instruct-fp8-fast, verified live
# 2026-09-18 (20/20 calls under realistic fact-check-shaped load).
# LLM_SECONDARY_URL=
# LLM_SECONDARY_API_KEY=

# --- Tokens and anti-abuse ---
TOKEN_SIGNING_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- News APIs ---
NEWSDATA_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=

# --- Extras data providers ---
OPENWEATHERMAP_API_KEY=
MARKET_API_KEY=
SPORTS_API_KEY=
TMDB_API_KEY=

# --- Images ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional URL field: leave commented out, not blank (see the note above
# LLM_FALLBACK_URL) — KEY= with nothing after it fails validation.
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- GCP ---
GCP_PROJECT_ID=
GCP_REGION=
GCS_PDF_BUCKET=

# --- PDF caching outside prod (local disk; ignored once GCS_PDF_BUCKET is set) ---
PDF_CACHE_DIR=

# --- Testing only: overrides config/editions.yaml's launch_date locally ---
# editions.yaml's own launch_date is still PROVISIONAL and stays that way
# until the owner is actually ready to go live — do not edit it just to test.
# Set this instead so a local build/late-update run against any edition_date
# is never blocked by that placeholder. Refused (raises) if APP_ENV=prod.
# EDITION_LAUNCH_DATE_OVERRIDE=2026-01-01
