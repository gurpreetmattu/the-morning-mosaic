# The Morning Mosaic — every environment variable, without values.
# Copy to .env for local development. Never commit .env.

# --- Core ---
APP_ENV=                      # dev | prod
BASE_URL=                     # public origin, e.g. https://<service>.run.app
TIMEZONE=Asia/Kolkata
LOG_LEVEL=

# --- Database (Neon, pooled connection string) ---
DATABASE_URL=

# --- Email sending (Gmail SMTP) ---
SMTP_HOST=
SMTP_PORT=
SENDER_EMAIL=
SENDER_NAME=
GMAIL_APP_PASSWORD=

# --- Bounce processing (same mailbox, read-only usage) ---
IMAP_HOST=
IMAP_PORT=

# --- Delivery safety ---
ADMIN_EMAIL=
TEST_EMAIL_ALLOWLIST=         # comma-separated; the only addresses dev may email
MAX_ACTIVE_SUBSCRIBERS=
FAILURE_NOTICE_AUTO_LIMIT=

# --- LLM access (freellmpool, OpenAI-compatible) ---
FREELLMPOOL_URL=
FREELLMPOOL_API_KEY=
LLM_FALLBACK_URL=
LLM_FALLBACK_API_KEY=

# --- Tokens and anti-abuse ---
TOKEN_SIGNING_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- News APIs ---
NEWSDATA_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=

# --- Extras data providers ---
OPENWEATHERMAP_API_KEY=
MARKET_API_KEY=
SPORTS_API_KEY=
TMDB_API_KEY=

# --- Images ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- GCP ---
GCP_PROJECT_ID=
GCP_REGION=
GCS_PDF_BUCKET=

# --- PDF caching outside prod (local disk; ignored once GCS_PDF_BUCKET is set) ---
PDF_CACHE_DIR=
