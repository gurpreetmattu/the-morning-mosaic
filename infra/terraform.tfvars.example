# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.

project_id   = "" # an existing, billing-enabled GCP project
sender_email = "" # the Gmail address the app sends from
admin_email  = "" # the one allowlisted admin-dashboard address

# Unreachable from Cloud Run until this is resolved — see the LLM gateway
# blocker in docs/BACKLOG.md. Set to whatever it becomes.
freellmpool_url = "http://127.0.0.1:8080/v1"

# Leave these on their defaults for the first apply; see infra/README.md
# for why base_url needs a second apply once web's real URL is known, and
# why backend_image/web_image start as unset placeholders.
# base_url      = ""
# backend_image = ""
# web_image     = ""
