{#
  Shared by section.html.j2 (the once-per-revision build-time render, used
  for the public archive) and email.html.j2 (the per-reader delivered
  email). Both must show the same image/AI-tool/releases/scores/deals for
  a genre — these are never personalised, only the story selection is — so
  this lives in one place rather than two copies that could drift.

  Expects `theme`, `image`, `ai_tool`, `movie_releases`, `music_releases`,
  `scores`, `fixtures`, and `game_deals` in the including template's scope.

  Each extra is a "telegram slip": tinted, dashed top and bottom, with a
  small caps label so its kind never rests on colour alone.
#}
{% set box = "margin:0 12px 18px 12px;padding:10px 12px;background:" ~ theme.accent_soft ~ ";border-top:1px dashed " ~ pal.ink ~ ";border-bottom:1px dashed " ~ pal.ink ~ ";font-family:" ~ theme.body_font ~ ";font-size:14px;line-height:1.5;color:" ~ pal.ink ~ ";" %}
{% set label = "font-family:" ~ pal.sans ~ ";font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:" ~ theme.accent ~ ";" %}
{% set link = "color:" ~ theme.accent ~ ";text-decoration:underline;" %}
{% if image %}
<p style="margin:0 12px 14px 12px;">
  <img src="{{ image.display_url }}" alt="" width="576" style="max-width:100%;height:auto;display:block;border:2px solid {{ pal.ink }};" />
  <span style="display:block;margin-top:4px;font-family:{{ pal.sans }};font-size:11px;color:{{ pal.ink_muted }};">{{ image.credit }}</span>
</p>
{% endif %}
{% if ai_tool %}
<p style="{{ box }}">
  <strong style="{{ label }}">AI tool of the day:</strong>
  {{ ai_tool.headline }} — {{ ai_tool.blurb }}
  (<a href="{{ ai_tool.source.url }}" style="{{ link }}">{{ ai_tool.source.name }}</a>)
</p>
{% endif %}
{% if movie_releases %}
<div style="{{ box }}">
  <strong style="{{ label }}">Coming soon:</strong>
  {% for release in movie_releases %}{{ release.title }} ({{ release.release_date }}){% if not loop.last %}, {% endif %}{% endfor %}
  <div style="margin-top:4px;font-family:{{ pal.sans }};font-size:11px;color:{{ pal.ink_muted }};">
    This newsletter uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.
  </div>
</div>
{% endif %}
{% if music_releases %}
<p style="{{ box }}">
  <strong style="{{ label }}">New releases:</strong>
  {% for release in music_releases %}{{ release.headline }} (<a href="{{ release.source.url }}" style="{{ link }}">{{ release.source.name }}</a>){% if not loop.last %}, {% endif %}{% endfor %}
</p>
{% endif %}
{% if scores %}
<p style="{{ box }}">
  <strong style="{{ label }}">Scores:</strong>
  {% for score in scores %}{{ score.team1 }} v {{ score.team2 }}: {{ score.status }}{% if not loop.last %}; {% endif %}{% endfor %}
</p>
{% endif %}
{% if fixtures %}
<p style="{{ box }}">
  <strong style="{{ label }}">Fixtures:</strong>
  {% for fixture in fixtures %}{{ fixture.team1 }} v {{ fixture.team2 }} ({{ fixture.when }}){% if not loop.last %}, {% endif %}{% endfor %}
</p>
{% endif %}
{% if game_deals %}
<p style="{{ box }}">
  <strong style="{{ label }}">Deals:</strong>
  {% for deal in game_deals %}<a href="{{ deal.url }}" style="{{ link }}">{{ deal.title }}</a> &ndash; {{ deal.savings_percent }}% off ({{ deal.store }}){% if not loop.last %}, {% endif %}{% endfor %}
</p>
{% endif %}
