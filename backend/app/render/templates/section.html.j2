{#
  One genre section, pre-rendered once per revision and reused for every
  reader who selected this genre.

  Email-safe by construction: inline styles only, no <style> block, no class
  selectors, no flexbox or grid. Gmail strips head styles and Outlook renders
  with Word, so anything else is a lottery.

  The section carries its own paper background so it stays readable when the
  archive page shows it on a dark theme.

  Autoescaping is on. Every value here came from a model, so it is treated as
  untrusted text throughout.
#}
<section style="margin:0 0 32px 0;padding:0 0 4px 0;background:{{ pal.paper_raised }};color:{{ pal.ink }};">
  {% include "_section_header.html.j2" %}

  {% if status == 'ok' %}
    {% include "_section_extras.html.j2" %}
    {% for story in stories %}
      {% include "_story.html.j2" %}
    {% endfor %}
  {% else %}
    <p style="margin:0 12px;padding:14px 16px;background:{{ theme.accent_soft }};border-left:4px solid {{ theme.accent }};font-family:{{ theme.body_font }};font-size:15px;line-height:1.5;color:{{ pal.ink }};">
      {{ note }}
    </p>
  {% endif %}
</section>
