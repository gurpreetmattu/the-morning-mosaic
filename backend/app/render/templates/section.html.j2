{#
  One genre section, pre-rendered once per revision and reused for every
  reader who selected this genre.

  Email-safe by construction: inline styles only, no <style> block, no class
  selectors, no flexbox or grid. Gmail strips head styles and Outlook renders
  with Word, so anything else is a lottery.

  Autoescaping is on. Every value here came from a model, so it is treated as
  untrusted text throughout.
#}
<section style="margin:0 0 32px 0;padding:0;">
  <h2 style="margin:0 0 4px 0;padding:0 0 6px 0;font-family:{{ theme.heading_font }};font-size:22px;line-height:1.25;color:{{ theme.accent }};border-bottom:2px solid {{ theme.rule }};">
    {{ section_title }}
  </h2>
  <p style="margin:0 0 18px 0;font-family:{{ theme.body_font }};font-size:13px;line-height:1.4;color:#5a5a5a;">
    {{ blurb }}
  </p>

  {% if status == 'ok' %}
    {% for story in stories %}
    <article style="margin:0 0 22px 0;padding:0 0 18px 0;border-bottom:1px solid {{ theme.rule }};">
      <h3 style="margin:0 0 8px 0;font-family:{{ theme.heading_font }};font-size:17px;line-height:1.3;color:#141414;">
        {{ story.headline }}
      </h3>

      {% if story.hedged %}
      <p style="margin:0 0 8px 0;padding:6px 10px;background:{{ theme.accent_soft }};font-family:{{ theme.body_font }};font-size:12px;line-height:1.4;color:#5a5a5a;">
        Reported by entertainment sources only. Treat as unconfirmed.
      </p>
      {% endif %}

      <p style="margin:0 0 10px 0;font-family:{{ theme.body_font }};font-size:15px;line-height:1.55;color:#242424;">
        {{ story.summary }}
      </p>

      {% if story.why_this_matters %}
      <p style="margin:0 0 10px 0;font-family:{{ theme.body_font }};font-size:14px;line-height:1.5;color:#3a3a3a;">
        <strong style="color:{{ theme.accent }};">Why this matters</strong>
        {{ story.why_this_matters }}
      </p>
      {% endif %}

      {# Every story links to its sources: the reader can always check us. #}
      <p style="margin:0;font-family:{{ theme.body_font }};font-size:12px;line-height:1.4;color:#6a6a6a;">
        {{ 'Sources' if story.sources | length > 1 else 'Source' }}:
        {% for source in story.sources %}<a href="{{ source.url }}" style="color:{{ theme.accent }};text-decoration:underline;">{{ source.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
    </article>
    {% endfor %}
  {% else %}
    <p style="margin:0;padding:14px 16px;background:{{ theme.accent_soft }};font-family:{{ theme.body_font }};font-size:14px;line-height:1.5;color:#3a3a3a;">
      {{ note }}
    </p>
  {% endif %}
</section>
